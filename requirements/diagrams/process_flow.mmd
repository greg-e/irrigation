---
title: Irrigation Inspection — Recommended Process Flow
---
flowchart TD
    classDef phase fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#0d47a1
    classDef sf fill:#fff3e0,stroke:#ef6c00,color:#e65100
    classDef mobile fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
    classDef ext fill:#f3e5f5,stroke:#6a1b9a,color:#4a148c
    classDef decision fill:#fff9c4,stroke:#f9a825,color:#f57f17
    classDef done fill:#c8e6c9,stroke:#2e7d32,color:#1b5e20

    %% ==== UPSTREAM (Phase 1, already built) ====
    subgraph UPSTREAM["1. Upstream — Work Generation (Phase 1)"]
        direction TB
        CPQ["Oracle CPQ<br/>quote signed"]:::ext --> SC["Service Contract<br/>created in SF"]:::sf
        SC --> WO["Work Order<br/>(Work Type = Irrigation - Quarterly)"]:::sf
        EW["ExtraWork<br/>estimate approved"]:::ext --> WOR["Reactive Work Order<br/>(Work Type = Irrigation - Repair)"]:::sf
        EM["Emergency call<br/>received"]:::ext --> WOE["Emergency Work Order<br/>(manual)"]:::sf
    end
    class UPSTREAM phase

    %% ==== DISPATCH ====
    WO --> DISP["Dispatch Console<br/>filter by Work Type + skill"]:::sf
    WOR --> DISP
    WOE --> DISP
    DISP --> SA["Service Appointment<br/>scheduled to Resource"]:::sf

    %% ==== FIELD EXECUTION ====
    subgraph FIELD["2. Field Execution — FSM Mobile (LWC)"]
        direction TB
        SA --> CHKIN["Tech checks in<br/>Status = In Progress"]:::mobile
        CHKIN --> GPS["LocationService LWC<br/>captures GPS<br/>→ SA + Asset lat/lng"]:::mobile
        GPS --> LOAD["Inspection LWC loads<br/>Question Set by Work Type<br/>(Quarterly / Winterization / NE-variant / etc.)"]:::mobile

        LOAD --> HDR["Section 1-3 Header<br/>controller state, backflow, meter,<br/>rain/freeze sensor, restrictions"]:::mobile
        HDR --> ZONELOOP["Section 6 — per-Zone loop<br/>distribution, runtime, 13 failure modes,<br/>photos, voice-to-text notes"]:::mobile
        ZONELOOP --> PROG["Section 9 — Programs A-D<br/>start times, water days, budget %<br/>→ Irrigation_Program__c records"]:::mobile
        PROG --> FOOT["Section 8 Footer<br/>recommendations, customer notes,<br/>internal notes, overall status"]:::mobile

        FOOT --> OFFLINE{"Offline-first sync<br/>queues all writes"}:::mobile
    end
    class FIELD phase

    %% ==== CHECKOUT ====
    OFFLINE --> SUGG["Pattern C 'Suggested Repairs' Review<br/>Failed Inspection_Response__c rows<br/>surface as draft WOLIs"]:::mobile
    class SUGG decision
    SUGG -->|tech confirms| WOLI["WorkOrderLineItem created<br/>Issue_Type__c, Asset__c,<br/>Source_Inspection_Response__c,<br/>Callout_Photo__c"]:::sf
    SUGG -->|tech dismisses| DISMISS["Response flagged failed<br/>but no callout created"]:::sf
    SUGG -->|tech merges| WOLIM["Multiple responses → 1 WOLI"]:::sf

    WOLI --> CHKOUT["Tech submits inspection<br/>SA status → Completed"]:::mobile
    DISMISS --> CHKOUT
    WOLIM --> CHKOUT

    %% ==== POST-VISIT AUTOMATION ====
    subgraph POST["3. Post-Visit — Salesforce Automation"]
        direction TB
        CHKOUT --> VAL["Validation rules fire<br/>require completion fields"]:::sf
        VAL --> FLOW1["Record-Triggered Flow<br/>on SA completion"]:::sf

        FLOW1 --> PDF1["Internal PDF generated<br/>(full detail incl. internal notes)"]:::sf
        FLOW1 --> PDF2["Customer-facing PDF generated<br/>(no internal notes / pricing)"]:::sf
        FLOW1 --> ASSET["Asset Status updated<br/>→ 'Needs Repair' for any callout"]:::sf

        PDF1 --> EMAIL1["Email to branch leadership<br/>+ Internal_PDF_Generated_At__c stamped"]:::sf
        PDF2 --> BV["Publish to BV Connect<br/>+ Customer_PDF_Generated_At__c stamped<br/>+ BV_Connect_Published__c = true"]:::sf
    end
    class POST phase

    %% ==== DOWNSTREAM ====
    subgraph DOWN["4. Downstream — Repair / Approval"]
        direction TB
        WOLI --> AM{"AM review<br/>quotable?"}:::decision
        AM -->|yes| EWQ["ExtraWork estimate<br/>line linked via<br/>ExtraWork_Estimate_Line_Ref__c"]:::ext
        AM -->|no, in-contract| SCHEDR["Schedule repair WO<br/>Work Type = Irrigation - Repair"]:::sf
        EWQ --> CUSTAPPR{"Customer approves?"}:::decision
        CUSTAPPR -->|yes| WOR2["Repair Work Order generated<br/>back through Phase 1 flow"]:::sf
        CUSTAPPR -->|no| CLOSE["WOLI Callout_Status__c<br/>= Declined / Closed"]:::done
        WOR2 --> SCHEDR
        SCHEDR --> NEXTSA["New Service Appointment<br/>(loop to Field Execution)"]:::sf
    end
    class DOWN phase

    %% ==== REPORTING ====
    BV --> RPT["Power BI nightly extract<br/>SA + Inspection_Response + WOLI<br/>→ irrigation manager dashboard"]:::ext
    EMAIL1 --> RPT
    class RPT done

    %% ==== ASSET HISTORY ====
    ASSET -.-> AH["Asset record retains<br/>full inspection + repair history<br/>via related lists"]:::sf
    class AH done
